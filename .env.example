# Bu dosyayı kurulum betiği otomatik oluşturur (.env). Elle düzenlemek için örnek.

# Programın açılacağı adres. Natro DNS panelinde bu ad için sunucu IP'sine A kaydı açılmalı.
ALAN_ADI=servis.firmaadi.com

POSTGRES_DB=servis
POSTGRES_USER=servis
POSTGRES_PASSWORD=degistir-uzun-rastgele-sifre

# Oturum çerezlerini imzalamak için gizli anahtar
OTURUM_GIZLI=degistir-uzun-rastgele-anahtar

# Yedekler kaç gün sunucuda saklansın
YEDEK_SAKLAMA_GUN=30

# (İsteğe bağlı) Yedeklerin ikinci bir yere kopyalanması için rclone hedefi.
# Örnek: gdrive:servis-yedek  veya  natro-ftp:yedek
# Boş bırakılırsa sadece sunucuda tutulur.
UZAK_YEDEK_HEDEF=
